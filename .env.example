# Copy to .env and fill only what you use. Everything is optional;
# the fleet degrades gracefully around anything left empty.

# Gate bridge (telegram adapter only)
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=          # optional; long-polling needs nothing

# Generic capability bindings (see binding/TOOLS.md)
IMAGE_API_URL=
IMAGE_API_KEY=
VIDEO_API_URL=
VIDEO_API_KEY=
SCHEDULER_API_URL=
SCHEDULER_API_KEY=
ANALYTICS_API_URL=
ANALYTICS_API_KEY=
LOCAL_DIFFUSION_URL=

# Host runner: your agent CLI's headless one-prompt command (default: claude)
# OTM_RUNNER=
